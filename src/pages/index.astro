---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Culture from "../components/Culture.astro";
import Partnerships from "../components/Partnerships.astro";
import Coach from "../components/Coach.astro";
import App from "../components/App.astro";
import Transformation from "../components/Transformation.astro";
import Footer from "../components/Footer.astro";
import { business } from "../data/business";

const title = "The Playground — Training is better together.";
const description = business.description;
---

<BaseLayout title={title} description={description} includeSchema>
  <Header />
  <main class="w-full max-w-full overflow-x-hidden flex flex-col">
    <Hero />
    <About />
    <div class="section-rule" aria-hidden="true"></div>
    <Culture />
    <div class="section-rule" aria-hidden="true"></div>
    <Partnerships />
    <div class="section-rule" aria-hidden="true"></div>
    <Coach />
    <div class="section-rule" aria-hidden="true"></div>
    <App />
    <div class="section-rule" aria-hidden="true"></div>
    <Transformation />
    <Footer />
  </main>
</BaseLayout>
