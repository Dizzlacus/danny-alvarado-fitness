---
import { partners } from "../data/partners";
---

<section id="collab" class="bg-brand-black w-full max-w-full overflow-hidden pb-[var(--section-space)]">
  <div class="site-container w-full">
    <div class="reveal section-heading">
      <p class="text-[0.65rem] font-medium tracking-[0.25em] uppercase text-white/50 mb-3">03 / Collab</p>
      <h2 class="poster-heading text-[clamp(2.75rem,9vw,5.75rem)] mb-4">
        Partnerships
      </h2>
      <p class="text-white/65 max-w-md leading-relaxed text-sm md:text-base">
        The gyms, spaces, and crews we train with. Names and locations are stand-ins until the real partners are locked.
      </p>
    </div>

    <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
      {
        partners.map((partner, index) => (
          <li class:list={["reveal", index === 1 && "reveal-delay-1", index === 2 && "reveal-delay-2"]}>
            <article class="flex h-full min-h-[16rem] flex-col items-center justify-center border border-white px-6 py-10 text-center">
              <p class="poster-heading text-3xl md:text-4xl">
                {partner.name}
              </p>
              <span class="mt-6 mb-4 block h-px w-10 bg-white" aria-hidden="true"></span>
              <p class="text-[0.65rem] font-medium tracking-[0.25em] uppercase text-white/50">{partner.role}</p>
              <p class="mt-2 text-xs tracking-wide text-white/50">{partner.location}</p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
