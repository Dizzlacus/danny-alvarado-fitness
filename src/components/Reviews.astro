---
import { reviews } from "../data/reviews";
---

<section id="reviews" class="bg-brand-black w-full max-w-full overflow-hidden pb-[var(--section-space)]">
  <div class="site-container">
    <div class="reveal section-heading flex flex-col gap-4 md:flex-row md:items-end md:justify-between md:gap-6">
      <div>
        <p class="text-[0.65rem] font-medium tracking-[0.25em] uppercase text-white/50 mb-3">04 / Reviews</p>
        <h2 class="font-display text-4xl md:text-6xl font-semibold text-white leading-tight md:max-w-[600px]">
          Built For Race Day
        </h2>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <button
          id="reviews-prev"
          type="button"
          class="w-10 h-10 flex items-center justify-center text-white/80 hover:text-brand-yellow transition-colors cursor-pointer"
          aria-label="Previous review"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        <button
          id="reviews-next"
          type="button"
          class="w-10 h-10 flex items-center justify-center text-white/80 hover:text-brand-yellow transition-colors cursor-pointer"
          aria-label="Next review"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="relative site-bleed-right reveal">
      <div id="reviews-track" class="flex items-stretch gap-10 md:gap-16 overflow-x-auto snap-x snap-mandatory pb-2">
        {
          reviews.map((review, index) => (
            <article class="review-card shrink-0 w-[80vw] sm:w-[52vw] md:w-[40vw] lg:w-[34vw] max-w-[480px] flex flex-col">
              <div class="flex items-start justify-between gap-4 mb-5">
                <span class="review-index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="review-quote" aria-hidden="true">
                  <span>”</span>
                </span>
              </div>
              <blockquote class="text-white/80 text-lg md:text-xl leading-relaxed min-w-0 flex flex-col flex-1">
                <p class="review-quote-text">{review.quote}</p>
                <button
                  type="button"
                  class="review-expand hidden mt-2 self-end text-white/50 hover:text-brand-yellow transition-colors cursor-pointer"
                  aria-expanded="false"
                  aria-label={`Read full review from ${review.name}`}
                >
                  <svg
                    class="review-expand-icon w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </button>
              </blockquote>
              <footer class="pt-6 mt-auto">
                <p class="font-medium text-white text-xs tracking-[0.15em] uppercase">{review.name}</p>
                {review.location && (
                  <p class="text-white/50 text-xs tracking-wide mt-1">{review.location}</p>
                )}
              </footer>
            </article>
          ))
        }
        <div class="site-scroll-end" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>
