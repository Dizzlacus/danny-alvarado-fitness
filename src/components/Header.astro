---
import PlaygroundWordmark from "./PlaygroundWordmark.astro";
---

<header id="site-header" class="fixed top-0 inset-x-0 z-30">
  <div class="site-container flex items-center justify-between h-16 md:h-[4.5rem]">
    <a
      href="#home"
      class="shrink-0 text-white"
      aria-label="The Playground"
    >
      <PlaygroundWordmark variant="compact" class="text-sm md:text-base" />
    </a>
    <nav class="flex items-center justify-end gap-6">
      <ul class="hidden md:flex items-center gap-5 lg:gap-8 text-xs font-medium tracking-[0.2em] uppercase text-white">
        <li><a href="#about" class="nav-link">About</a></li>
        <li><a href="#culture" class="nav-link">Culture</a></li>
        <li><a href="#collab" class="nav-link">Collab</a></li>
        <li><a href="#danny" class="nav-link">Danny</a></li>
        <li><a href="#app" class="nav-link">App</a></li>
        <li><a href="#transformation" class="nav-link">Transformation</a></li>
      </ul>
      <button
        id="nav-burger"
        type="button"
        class="md:hidden relative w-10 h-10 flex items-center justify-center text-white"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-mobile-panel"
      >
        <svg id="icon-hamburger" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7h16M4 17h16"></path>
        </svg>
        <svg id="icon-close" class="w-6 h-6 is-hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </nav>
  </div>
  <div id="nav-mobile-panel" class="md:hidden border-t border-white/10 bg-brand-black/95 backdrop-blur-sm" aria-hidden="true">
    <ul class="site-container py-4 space-y-3 text-sm font-medium tracking-wide text-white">
      <li><a href="#about" class="block py-2 hover:text-white/70 transition-colors">About</a></li>
      <li><a href="#culture" class="block py-2 hover:text-white/70 transition-colors">Culture</a></li>
      <li><a href="#collab" class="block py-2 hover:text-white/70 transition-colors">Collab</a></li>
      <li><a href="#danny" class="block py-2 hover:text-white/70 transition-colors">Danny</a></li>
      <li><a href="#app" class="block py-2 hover:text-white/70 transition-colors">App</a></li>
      <li><a href="#transformation" class="block py-2 hover:text-white/70 transition-colors">Transformation</a></li>
    </ul>
  </div>
</header>
