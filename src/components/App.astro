---
import { business, businessInstagram } from "../data/business";
---

<section id="app" class="bg-brand-black w-full max-w-full overflow-hidden pb-[var(--section-space)]">
  <div class="site-container w-full">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="text-[0.65rem] font-medium tracking-[0.25em] uppercase text-white/50 mb-3">05 / App</p>
      <h2 class="poster-heading text-[clamp(3rem,11vw,6.75rem)] mb-8">
        <span class="block">The app</span>
        <span class="block">is coming</span>
      </h2>
      <p class="wordmark-tagline mx-auto max-w-md mb-8">{business.tagline}</p>
      <p class="text-white/65 max-w-md mx-auto leading-relaxed text-sm md:text-base mb-8">
        Sessions, challenges, and a reason to show up with the group — all in one place. Coming soon.
      </p>
      <a
        href={businessInstagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="hero-cta inline-flex items-center justify-center px-5 sm:px-6 py-3 text-[0.65rem] sm:text-xs font-medium tracking-[0.15em] sm:tracking-[0.2em] uppercase text-white transition-colors"
      >
        Follow {businessInstagram.handle}
      </a>
    </div>
  </div>
</section>
