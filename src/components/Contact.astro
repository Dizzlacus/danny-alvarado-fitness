---
import { Image } from "astro:assets";
import { business, businessInstagram } from "../data/business";
import finish from "../assets/images/celebration.jpg";

const telHref = `tel:${business.telephone.replace(/\s/g, "")}`;
---

<section id="contact" class="bg-brand-black w-full max-w-full overflow-hidden pb-[var(--section-space)]">
  <div class="site-container w-full">
    <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center w-full min-w-0">
      <div class="reveal">
        <p class="text-[0.65rem] font-medium tracking-[0.25em] uppercase text-white/50 mb-3">05 / Contact</p>
        <h2 class="font-display text-4xl md:text-6xl font-semibold text-white mb-4">Get in touch</h2>
        <p class="text-white/65 max-w-md leading-relaxed text-sm md:text-base mb-8">
          Location and booking channels are placeholders for now. Use the details below once they are confirmed.
        </p>
        <address class="not-italic space-y-2 text-white/80 mb-8">
          <p>
            <a
              href={business.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-brand-yellow transition-colors"
            >
              {business.address.streetAddress}<br />
              {business.address.addressLocality} {business.address.postalCode}
            </a>
          </p>
        </address>
        <div class="space-y-3 text-sm md:text-base text-white/80">
          <p>
            <span class="text-white/50">Telephone:</span>{" "}
            <a href={telHref} class="hover:text-brand-yellow transition-colors">{business.telephone}</a>
          </p>
          <p>
            <span class="text-white/50">Instagram:</span>{" "}
            <a
              href={businessInstagram.url}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-brand-yellow transition-colors"
            >
              {businessInstagram.handle}
            </a>
          </p>
          <p>
            <span class="text-white/50">Email:</span>{" "}
            <a href={`mailto:${business.email}`} class="hover:text-brand-yellow transition-colors">{business.email}</a>
          </p>
        </div>
      </div>
      <div class="reveal reveal-delay-1">
        <div class="relative aspect-[4/3] w-full bg-brand-black overflow-hidden">
          <Image
            src={finish}
            alt="Danny Alvarado celebrating after a race effort"
            widths={[400, 720, 1100]}
            sizes="(min-width: 768px) 50vw, calc(100vw - 3rem)"
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>
