---
import { Image, getImage } from "astro:assets";
import poster from "../assets/images/hero-poster.jpg";

const videoSrc = `${import.meta.env.BASE_URL}videos/hero.mp4`;
const videoSrcMobile = `${import.meta.env.BASE_URL}videos/hero-mobile.mp4`;
const posterImage = await getImage({ src: poster, width: 1280, format: "jpg" });
---

<section id="home" class="relative isolate w-full max-w-full overflow-hidden bg-brand-black min-h-[100svh]">
  <div class="hero-media absolute inset-0" aria-hidden="true">
    <Image
      src={poster}
      alt=""
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <video
      class="hero-video absolute inset-0 h-full w-full object-cover"
      poster={posterImage.src}
      data-src-desktop={videoSrc}
      data-src-mobile={videoSrcMobile}
      autoplay
      muted
      loop
      playsinline
      webkit-playsinline
      preload="auto"
      disablepictureinpicture
    ></video>
    <div class="hero-media-overlay absolute inset-0 z-[1] pointer-events-none"></div>
  </div>

  <div
    class="hero-copy relative z-[2] flex min-h-[100svh] flex-col items-center justify-center text-center site-container pt-[var(--header-offset)] pb-10"
  >
    <h1
      class="reveal font-display text-[clamp(1.85rem,6.5vw,4.25rem)] font-bold text-white tracking-[0.06em] sm:tracking-[0.1em] md:tracking-[0.14em] leading-none [text-wrap:balance] pb-1"
    >
      <span class="block">Race-Ready Hyrox</span>
      <span class="block"><span class="text-brand-yellow">Training</span> Built For You.</span>
    </h1>
    <p class="reveal reveal-delay-1 mt-6 text-sm md:text-base text-white/90 max-w-lg leading-relaxed tracking-wide">
      Personal training for Hyrox and functional race prep — station work, running, and strength programmed so you show up ready.
    </p>
    <div class="reveal reveal-delay-2 hero-cta-group mt-8">
      <a
        href="#gallery"
        class="hero-cta inline-flex items-center justify-center px-5 sm:px-6 py-3 text-[0.65rem] sm:text-xs font-medium tracking-[0.15em] sm:tracking-[0.2em] uppercase text-white transition-colors"
      >
        See training
      </a>
      <a
        href="#contact"
        class="hero-cta inline-flex items-center justify-center px-5 sm:px-6 py-3 text-[0.65rem] sm:text-xs font-medium tracking-[0.15em] sm:tracking-[0.2em] uppercase text-white transition-colors"
      >
        Book a session
      </a>
    </div>
  </div>
</section>
